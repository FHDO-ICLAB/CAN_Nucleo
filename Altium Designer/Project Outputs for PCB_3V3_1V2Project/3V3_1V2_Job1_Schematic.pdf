 + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj10 0 obj<</JS(function ShowCompProps_2E142DEEDA3E4A4BB34840CE0376E3A7\(\){var sChoice = app.popUpMenu\("Bus Fault Voltage\(V\): ","Code_JEDEC: MS-012AA","Comment: SN65HVD232DR","Component Kind: Standard","ComponentLink1Description: Datasheet","ComponentLink1URL: http:/\/www.ti.com/general/docs/lit/getliterature.tsp?genericPartNumber=SN65HVD232&fileType=pdf","ComponentLink2Description: ","ComponentLink2URL: ","DatasheetVersion: SLOS346K","Description: 3.3 V Can Transceiver, 17 mA, -40 to 85 degC, 8-pin SOIC \(D\), Green \\(RoHS & no Sb/Br\)","Drivers Per Package: 1","Eco-Plan: Green \(RoHS & no Sb/Br\)","Features: ","Footprint: SN65HVD232","Ibis Model: ","ICC\(Max\)\(mA\): 17","Isolated: No","Library Name: Altium Content Vault","Library Reference: CMP-0315-00075-2","Low P\ower Mode: ","Manufacturer: Texas Instruments","Mounting Technology: Surface Mount","PackageDescription: 8-Pin Plastic Small Outline Integrated Circuit, 4.9 x 3.9 mm, Pitch 1.27 mm Pitch","PackageReference: D0008A","PackageVersion: revM, Jun-2011","PartNu\mber: SN65HVD232DR","PCB3D: ","Pin Info: ","Rating: Catalog","Receivers Per Package: 1","Signal Integrity: ","Simulation: ","SubFamily: CAN","Supply Voltage\(s\)\(V\): 3.3","Transient Pulse Protection\(V\): -25 to 25"\); if \(sChoice\) {var nUrlPos = sCho\ice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== 